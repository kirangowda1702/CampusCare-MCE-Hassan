# ==========================================================
# CampusCare – MCE Hassan Telemedicine Environment Config
# ==========================================================

# ----------------------------------------------------------
# 1. PUBLIC BROWSER-SAFE VARIABLES (VITE_ Prefix)
# These variables are bundled into the client browser application.
# Do NOT place private secrets, master passwords, or service-role keys here.
# ----------------------------------------------------------

# Supabase Public API Credentials (Protected by Database Row Level Security)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google Maps Platform JavaScript API Key (Browser Client)
# Restrict this key in Google Cloud Console to your HTTP Referrers / Domain
# If omitted, CampusCare runs with the offline Hassan Geodesic Coordinate Map
VITE_GOOGLE_MAPS_API_KEY=

# WebRTC STUN Server (Public Discovery Endpoint)
VITE_STUN_SERVER=stun:stun.l.google.com:19302

# College Campus Deployment Metadata
VITE_COLLEGE_NAME=Malnad College of Engineering, Hassan
VITE_CAMPUS_LOCATION=Hassan, Karnataka 573202

# ----------------------------------------------------------
# 2. SERVER-ONLY SECRETS (NO VITE_ Prefix)
# STRICT SECURITY WARNING: NEVER commit real values or expose to the frontend.
# Set these strictly in Supabase Edge Functions or Backend Server environments.
# ----------------------------------------------------------

# Supabase Service Role Key (Admin / Bypass RLS for secure background tasks only)
# NEVER add VITE_ prefix to this key!
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider API Key (Google Gemini / OpenAI / Anthropic)
# Server-side proxy / Edge function execution only
AI_PROVIDER_API_KEY=

# WebRTC TURN Relay Infrastructure (Private TURN Credentials)
# Required for strict symmetric enterprise NAT/firewall traversal
TURN_SERVER=
TURN_USERNAME=
TURN_CREDENTIAL=
